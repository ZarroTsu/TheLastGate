# Makefile for SDL2 Magic Glow Effect Demo
# Usage: make -f Makefile.magic

CC = gcc
CFLAGS = -Wall -Wextra -O2 -I.
LIBS = -lSDL2 -lSDL2_image -lm

# Detect MinGW on Windows
ifeq ($(OS),Windows_NT)
    LIBS = -lmingw32 -lSDL2main -lSDL2 -lSDL2_image -lm
endif

TARGET = magic_demo
SOURCES = sdl_magic_demo.c sdl_magic.c
OBJECTS = $(SOURCES:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)
	@echo "Build complete! Run with: ./$(TARGET)"

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(TARGET) $(TARGET).exe

run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run

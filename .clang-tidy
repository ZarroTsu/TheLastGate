Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-*,
  -llvm-header-guard

CheckOptions:
  - { key: readability-identifier-length.IgnoredVariableNames, value: '^(i|j|k|io|id)$' }
  - { key: readability-identifier-length.IgnoredParameterNames, value: '^(id)$' }
  - { key: readability-braces-around-statements.ShortStatementLines, value: 1 }